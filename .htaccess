# Acre&Key – Hostinger / LiteSpeed
# Serve the branded 404 page for missing URLs

Options -MultiViews
ErrorDocument 404 /404.html

DirectoryIndex index.html

# Enable Rewrite Engine for extensionless URLs
RewriteEngine On

# 301: renamed calculators (brand rules)
RewriteRule ^calculators/luxury-home-affordability-calculator/?(.*)$ /calculators/hni-home-affordability-calculator/$1 [L,R=301]
RewriteRule ^calculators/dream-home-timeline-planner/?(.*)$ /calculators/home-buying-timeline-planner/$1 [L,R=301]

# 301: blog plural to singular canonical
RewriteRule ^blogs/?(.*)$ /blog/$1 [L,R=301]

# 301: retired partners page to the home page
RewriteRule ^partners\.html$ / [L,R=301,NC]
RewriteRule ^partners/?$ / [L,R=301,NC]

# 301 Redirect to strip index.html from URLs
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^/]+/)*index\.html\ HTTP/ [NC]
RewriteRule ^(([^/]+/)*)index\.html$ /$1 [L,R=301]

# If the request is not for a directory
RewriteCond %{REQUEST_FILENAME} !-d
# And if the request is not for an existing file
RewriteCond %{REQUEST_FILENAME} !-f
# And if the request with .html appended is a file
RewriteCond %{REQUEST_FILENAME}.html -f
# Rewrite the request to the .html file
RewriteRule ^(.*)$ $1.html [L,QSA]

# Security Headers
<IfModule mod_headers.c>
    # Enforce HTTPS
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Prevent MIME-sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Prevent Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Control Referrer information
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
